{
  "$schema": "https://schema.tauri.app/v2/tauri.conf.json",
  "productName": "SplatCat",
  "version": "0.1.0",
  "identifier": "com.splatcat.desktop",
  "build": {
    "devUrl": "../",
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SplatCat 🐾 — 3D Gaussian Splatting Suite",
        "width": 1280,
        "height": 830,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
